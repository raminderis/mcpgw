# cfgUpdater configuration

# Port that cfgUpdater listens on
CFG_UPDATER_PORT=:9091

# Path to shared gwsvc config file
GWSVC_CONFIG_FILE=./gwsvc-config.json

# URL of gwsvc service for triggering graceful shutdown and restart after config updates
# After config is updated, cfgUpdater will POST to GWSVC_URL/shutdown
# The orchestrator (Docker Compose, Kubernetes) must have restart:always policy
# In Docker Compose use the service name: http://gwsvc:9090
# Locally use: http://localhost:9090
GWSVC_URL=http://localhost:9090

# Default gwsvc listen port (used if config file doesn't exist)
GWSVC_DEFAULT_PORT=9090
